DISCORD_TOKEN=your-bot-token
# Translation (DeepL). Free keys end in ":fx".
DEEPL_API_KEY=your-deepl-key
# Optional: Google Cloud Translation (v2) key, used when a server picks it with /server-settings translate-api.
GOOGLE_TRANSLATE_API_KEY=

# Optional: channels to start with auto-translate on (comma-separated IDs).
# After that, use /translate in a channel to change or turn off its language.
TRANSLATE_CHANNEL_IDS=
# Language for the channels above: chinese | japanese (default: chinese)
TRANSLATE_DEFAULT_LANGUAGE=chinese

# Supabase config store (optional). When set, config is read from the bot_config
# table and overrides config/commands/*.yaml. Server-side secret, never expose it.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_KEY=your-service-role-key

# Optional: Google Gemini key for /ask and /vcask (Flash-Lite). Get one at https://aistudio.google.com/apikey
GEMINI_API_KEY=your-gemini-api-key
# Optional: override the model (default: gemini-3.5-flash-lite)
# GEMINI_MODEL=gemini-3.5-flash-lite
