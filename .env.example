DISCORD_TOKEN=your-bot-token
# Translation (DeepL). Free keys end in ":fx".
DEEPL_API_KEY=your-deepl-key

# Optional: channels to start with auto-translate on (comma-separated IDs).
# After that, use /translate in a channel to change or turn off its language.
TRANSLATE_CHANNEL_IDS=
# Language for the channels above: chinese | japanese (default: chinese)
TRANSLATE_DEFAULT_LANGUAGE=chinese
