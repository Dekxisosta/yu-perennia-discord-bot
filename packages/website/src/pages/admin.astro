---
import Base from '../layouts/Base.astro';
import { SUPABASE_URL, SUPABASE_ANON_KEY } from '../site';

const configured = Boolean(SUPABASE_URL && SUPABASE_ANON_KEY);
---

<Base title="Admin · Yu Perennia" description="Yu Perennia admin dashboard." noindex>
  <header class="bar">
    <div class="wrap bar__inner">
      <a class="brand" href="/">
        <img src="/yu.png" width="44" height="44" alt="" />
        <span>Yu Perennia</span>
      </a>
      <span class="tag">Admin</span>
      <button type="button" class="btn btn--ink lock" id="lock" hidden>Lock</button>
    </div>
  </header>

  <main class="admin" data-url={SUPABASE_URL} data-anon={SUPABASE_ANON_KEY}>
    <div class="wrap">
      {
        !configured && (
          <section class="card">
            <h1>Not connected</h1>
            <p class="lede">
              Set <code>PUBLIC_SUPABASE_URL</code> and <code>PUBLIC_SUPABASE_ANON_KEY</code> in the website's
              <code>.env</code>, then rebuild.
            </p>
          </section>
        )
      }

      {
        configured && (
          <>
            <section class="card gate" id="gate">
              <h1>Admin key</h1>
              <p class="lede">Enter your admin key to open the dashboard.</p>
              <form id="gate-form" autocomplete="off">
                <label for="key">Key</label>
                <input id="key" type="password" spellcheck="false" autocomplete="off" required />
                <button class="btn btn--tan" type="submit">Unlock</button>
              </form>
              <p class="msg" id="gate-msg" role="alert"></p>
            </section>

            <section id="dash" hidden>
              <div class="dash__head">
                <h1 class="dash__title">Dashboard</h1>
                <button type="button" class="btn btn--ink" id="refresh">Refresh bot</button>
              </div>
              <p class="msg" id="rf-msg" role="status"></p>
              <div class="stats" id="stats"></div>

              <div class="split">
                <nav class="files" aria-label="Config files" id="files"></nav>

                <div class="card editor">
                  <div class="editor__head">
                    <h2 id="ed-name">Select a file</h2>
                    <span class="meta" id="ed-meta"></span>
                  </div>
                  <div class="tabs">
                    <button type="button" class="tab" id="tab-form" aria-pressed="true">Form</button>
                    <button type="button" class="tab" id="tab-json" aria-pressed="false">JSON</button>
                    <input id="filter" type="search" placeholder="Filter fields…" aria-label="Filter fields" disabled />
                  </div>
                  <div class="form" id="form"></div>
                  <label for="ed" class="sr">Config JSON</label>
                  <textarea id="ed" spellcheck="false" disabled hidden></textarea>
                  <div class="actions">
                    <button class="btn btn--tan" type="button" id="save" disabled>Save to Supabase</button>
                    <button class="btn" type="button" id="reset" disabled>Revert</button>
                    <button class="btn" type="button" id="new">New file</button>
                    <button class="btn btn--danger" type="button" id="del" disabled>Delete file</button>
                  </div>
                  <p class="msg" id="ed-msg" role="status"></p>
                  <p class="hint">Yu re-checks config files every 6 hours. Click Refresh bot (top of the page) to apply changes within about 30 seconds. Slash-command descriptions in Discord's menu still need a bot restart.</p>
                </div>
              </div>

              <h2 class="sec">Bot status</h2>
              <div class="card">
                <p class="hint">
                  What Yu shows in Discord's member list. Changes apply within about 30 seconds, no restart needed.
                </p>
                <form id="st-form" class="chform" autocomplete="off">
                  <div>
                    <label for="st-status">Status</label>
                    <select id="st-status">
                      <option value="online">Online</option>
                      <option value="idle">Idle</option>
                      <option value="dnd">Do not disturb</option>
                      <option value="invisible">Invisible</option>
                    </select>
                  </div>
                  <div>
                    <label for="st-type">Activity</label>
                    <select id="st-type">
                      <option value="none">None</option>
                      <option value="playing">Playing</option>
                      <option value="listening">Listening to</option>
                      <option value="watching">Watching</option>
                      <option value="competing">Competing in</option>
                      <option value="custom">Custom status</option>
                    </select>
                  </div>
                  <div>
                    <label for="st-text">Text</label>
                    <input id="st-text" maxlength="128" placeholder="Serving tea at Cafe Camellia" />
                  </div>
                  <button class="btn btn--tan" type="submit">Save status</button>
                </form>
                <p class="hint" id="st-preview"></p>
                <p class="msg" id="st-msg" role="status"></p>
              </div>

              <h2 class="sec">Translation channels</h2>
              <div class="card chans">
                <p class="hint">
                  Channels where Yu auto-translates. Changes reach the bot within about a minute. Use the note to
                  remember which channel an ID is. Discord channel IDs come from Developer Mode, then right-click a channel, then Copy Channel ID.
                </p>
                <div class="tablewrap">
                  <table>
                    <thead>
                      <tr><th>Channel ID</th><th>Language</th><th>Note</th><th></th></tr>
                    </thead>
                    <tbody id="ch-body"></tbody>
                  </table>
                </div>
                <form id="ch-form" class="chform" autocomplete="off">
                  <div>
                    <label for="ch-id">Channel ID</label>
                    <input id="ch-id" inputmode="numeric" pattern="[0-9]{5,25}" placeholder="123456789012345678" required />
                  </div>
                  <div>
                    <label for="ch-lang">Language</label>
                    <select id="ch-lang">
                      <option value="zh">Chinese</option>
                      <option value="ja">Japanese</option>
                      <option value="off">Off</option>
                    </select>
                  </div>
                  <div>
                    <label for="ch-note">Note (optional)</label>
                    <input id="ch-note" maxlength="60" placeholder="#general" />
                  </div>
                  <button class="btn btn--tan" type="submit">Add channel</button>
                </form>
                <p class="msg" id="ch-msg" role="status"></p>
              </div>
            </section>
          </>
        )
      }
    </div>
  </main>
</Base>

<style>
  .bar {
    background: var(--paper);
    border-bottom: var(--border);
  }
  .bar__inner {
    display: flex;
    align-items: center;
    gap: 1rem;
    padding-block: 0.65rem;
  }
  .brand {
    display: flex;
    align-items: center;
    gap: 0.7rem;
    font-family: var(--font-display);
    font-size: 1.6rem;
    font-weight: 800;
    font-stretch: 75%;
    text-decoration: none;
  }
  .brand img {
    border: var(--border);
    background: var(--mist);
  }
  .tag {
    margin-right: auto;
    padding: 0.1rem 0.6rem;
    border: var(--border);
    background: var(--tan);
    font-family: var(--font-mono);
    font-weight: 500;
  }
  .lock {
    min-height: 2.6rem;
    font-size: 1.05rem;
    box-shadow: var(--shadow-sm);
  }
  .lock[hidden],
  [hidden] {
    display: none !important;
  }

  .admin {
    min-height: 70vh;
    padding-block: clamp(2rem, 6vw, 4rem);
    background: var(--mist);
  }
  h1 {
    font-size: clamp(2.5rem, 6vw, 4rem);
  }
  .card {
    background: var(--paper);
    border: var(--border);
    box-shadow: var(--shadow);
    padding: clamp(1.25rem, 3vw, 2rem);
  }
  .gate {
    max-width: 30rem;
  }
  form {
    display: grid;
    gap: 0.5rem;
    margin-top: 1.5rem;
  }
  label {
    font-weight: 700;
  }
  .sr {
    position: absolute;
    width: 1px;
    height: 1px;
    overflow: hidden;
    clip: rect(0 0 0 0);
  }
  input,
  textarea {
    width: 100%;
    border: var(--border);
    background: #fff8;
    color: var(--ink);
    font-family: var(--font-mono);
    font-size: 1rem;
    padding: 0.7rem 0.8rem;
    border-radius: 0;
  }
  form .btn {
    margin-top: 0.75rem;
    justify-self: start;
  }
  .msg {
    margin-top: 1rem;
    min-height: 1.5em;
    font-weight: 650;
  }
  .msg.err {
    color: #7a1f1f;
  }
  .msg.ok {
    color: #1f5a2e;
  }
  .hint {
    margin-top: 0.5rem;
    color: var(--cocoa);
    font-size: 0.95rem;
  }

  .dash__head {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
  }
  .dash__head .btn {
    box-shadow: var(--shadow-sm);
  }
  .dash__title {
    margin-bottom: 0;
  }
  #rf-msg {
    margin-bottom: 1rem;
  }
  .stats {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(11rem, 1fr));
    gap: 1rem;
    margin-bottom: 2rem;
  }
  .stat {
    background: var(--tan);
    border: var(--border);
    box-shadow: var(--shadow-sm);
    padding: 0.9rem 1.1rem;
  }
  .stat b {
    display: block;
    font-family: var(--font-display);
    font-size: 2.4rem;
    font-weight: 800;
    font-stretch: 75%;
    line-height: 1;
  }
  .stat span {
    font-weight: 650;
  }

  .split {
    display: grid;
    grid-template-columns: 15rem 1fr;
    gap: 1.5rem;
    align-items: start;
  }
  .files {
    display: grid;
    gap: 0.6rem;
  }
  .files button {
    display: flex;
    justify-content: space-between;
    gap: 0.5rem;
    width: 100%;
    padding: 0.6rem 0.8rem;
    border: var(--border);
    background: var(--paper);
    color: var(--ink);
    box-shadow: var(--shadow-sm);
    font-family: var(--font-mono);
    font-size: 0.95rem;
    font-weight: 500;
    text-align: left;
    cursor: pointer;
  }
  .files button[aria-current='true'] {
    background: var(--ink);
    color: var(--paper);
  }
  .editor__head {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    justify-content: space-between;
    gap: 0.5rem 1rem;
    margin-bottom: 1rem;
  }
  .editor h2 {
    font-size: 2rem;
  }
  .meta {
    color: var(--cocoa);
    font-size: 0.95rem;
  }
  textarea {
    min-height: 26rem;
    resize: vertical;
    line-height: 1.5;
    tab-size: 2;
    white-space: pre;
  }
  .actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.9rem;
    margin-top: 1.25rem;
  }
  .actions .btn {
    min-height: 2.6rem;
    font-size: 1.05rem;
    box-shadow: var(--shadow-sm);
  }
  .actions .btn:disabled {
    opacity: 0.5;
    cursor: not-allowed;
    transform: none;
  }
  .sec {
    margin: 2.5rem 0 1rem;
    font-size: clamp(2rem, 4vw, 2.75rem);
  }
  .tablewrap {
    overflow-x: auto;
    margin-top: 1rem;
  }
  table {
    width: 100%;
    border-collapse: collapse;
    min-width: 36rem;
  }
  th,
  td {
    padding: 0.5rem 0.5rem 0.5rem 0;
    text-align: left;
    vertical-align: middle;
  }
  th {
    font-weight: 700;
    border-bottom: var(--border);
  }
  td code {
    font-size: 0.95rem;
  }
  select {
    border: var(--border);
    background: #fff8;
    color: var(--ink);
    font: inherit;
    padding: 0.6rem 0.6rem;
    border-radius: 0;
  }
  .rowbtn {
    margin-right: 0.4rem;
    padding: 0.4rem 0.8rem;
    border: var(--border);
    background: var(--paper);
    color: var(--ink);
    font: inherit;
    font-weight: 700;
    cursor: pointer;
  }
  .rowbtn:hover {
    background: var(--tan);
  }
  .empty {
    padding: 1rem 0;
    color: var(--cocoa);
  }
  .chform {
    grid-template-columns: repeat(auto-fit, minmax(11rem, 1fr));
    align-items: end;
    gap: 1rem;
    margin-top: 1.5rem;
    padding-top: 1.25rem;
    border-top: var(--border);
  }
  .chform > div {
    display: grid;
    gap: 0.4rem;
  }
  .chform .btn {
    margin-top: 0;
    min-height: 2.9rem;
  }
  @media (max-width: 52rem) {
    .split {
      grid-template-columns: 1fr;
    }
    .files {
      grid-template-columns: repeat(auto-fit, minmax(10rem, 1fr));
    }
  }
</style>

<style is:global>
  .admin .stat { background: var(--tan); border: var(--border); box-shadow: var(--shadow-sm); padding: 0.9rem 1.1rem; }
  .admin .stat b { display: block; font-family: var(--font-display); font-size: 2.4rem; font-weight: 800; font-stretch: 75%; line-height: 1; }
  .admin .stat span { font-weight: 650; }
  .admin .files button { display: flex; justify-content: space-between; gap: 0.5rem; width: 100%; padding: 0.6rem 0.8rem; border: var(--border); background: var(--paper); color: var(--ink); box-shadow: var(--shadow-sm); font-family: var(--font-mono); font-size: 0.95rem; font-weight: 500; text-align: left; cursor: pointer; }
  .admin .files button[aria-current='true'] { background: var(--ink); color: var(--paper); }
  .admin .rowbtn { margin-right: 0.4rem; padding: 0.4rem 0.8rem; border: var(--border); background: var(--paper); color: var(--ink); font: inherit; font-weight: 700; cursor: pointer; }
  .admin .rowbtn:hover { background: var(--tan); }
  .admin .empty { padding: 1rem 0; color: var(--cocoa); }
  .admin td select, .admin td input { width: 100%; border: var(--border); background: #fff8; color: var(--ink); font: inherit; padding: 0.6rem; border-radius: 0; }

  .admin .btn--danger { background: #e9b3b3; }
  .admin .tabs { display: flex; flex-wrap: wrap; align-items: center; gap: 0.5rem; margin-bottom: 1rem; }
  .admin .tab { padding: 0.4rem 1rem; border: var(--border); background: var(--paper); color: var(--ink); font: inherit; font-weight: 700; cursor: pointer; }
  .admin .tab[aria-pressed='true'] { background: var(--ink); color: var(--paper); }
  .admin .tabs input { margin-left: auto; width: min(16rem, 100%); }
  .admin .form { display: grid; gap: 0.6rem; max-height: 36rem; overflow: auto; padding-right: 0.25rem; }
  .admin .form .none { color: var(--cocoa); padding: 0.5rem 0; }
  .admin .row { display: grid; grid-template-columns: minmax(7rem, 12rem) 1fr auto; gap: 0.6rem; align-items: start; }
  .admin .row--item { grid-template-columns: 1.8rem 1fr auto; }
  .admin .row__key { padding-top: 0.6rem; font-family: var(--font-mono); font-weight: 500; overflow-wrap: anywhere; }
  .admin .form input:not([type='checkbox']),
  .admin .form textarea,
  .admin .tabs input,
  .admin .addrow input {
    box-sizing: border-box;
    width: 100%;
    border: var(--border);
    border-radius: 0;
    background: #fff8;
    color: var(--ink);
    font-family: var(--font-mono);
    font-size: 1rem;
    line-height: 1.45;
    padding: 0.6rem 0.8rem;
  }
  .admin .form input:focus,
  .admin .form textarea:focus,
  .admin .tabs input:focus,
  .admin .addrow input:focus { outline: 3px solid var(--tan); outline-offset: 0; }
  .admin .row textarea { min-height: 0; resize: vertical; white-space: pre-wrap; overflow: hidden; }
  .admin .row__key { font-size: 1rem; }
  .admin .row input[type='checkbox'] { width: 1.3rem; height: 1.3rem; margin-top: 0.7rem; }
  .admin .node { border: var(--border); background: #fff5; }
  .admin .node > summary { display: flex; align-items: center; gap: 0.6rem; padding: 0.5rem 0.7rem; cursor: pointer; font-family: var(--font-mono); }
  .admin .node__name { font-weight: 700; overflow-wrap: anywhere; }
  .admin .node__count { margin-right: auto; color: var(--cocoa); font-size: 0.9rem; }
  .admin .node__body { display: grid; gap: 0.6rem; padding: 0.7rem; border-top: var(--border); }
  .admin .mini-group { display: flex; gap: 0.35rem; padding-top: 0.15rem; }
  .admin .mini { font-size: 0.85rem; padding: 0.3rem 0.6rem; border: var(--border); background: var(--paper); color: var(--ink); font: inherit; font-weight: 700; line-height: 1.3; cursor: pointer; }
  .admin .mini:hover { background: var(--tan); }
  .admin .addrow { display: flex; flex-wrap: wrap; align-items: center; gap: 0.5rem; padding-top: 0.2rem; }
  .admin .addrow input { flex: 1 1 10rem; width: auto; }
  .admin .addrow select { border: var(--border); background: #fff8; color: var(--ink); font: inherit; padding: 0.6rem; border-radius: 0; }
  .admin .addrow .rowbtn { margin: 0; }
  .admin .idx { padding-top: 0.7rem; color: var(--cocoa); font-family: var(--font-mono); text-align: right; }
  @media (max-width: 40rem) {
    .admin .row { grid-template-columns: 1fr auto; }
    .admin .row__key { grid-column: 1 / -1; padding-top: 0; }
    .admin .row--item { grid-template-columns: 1fr auto; }
    .admin .idx { display: none; }
  }
</style>

<script>
  type Row = { name: string; data: Record<string, unknown>; updated_at: string };

  const root = document.querySelector<HTMLElement>('.admin');
  if (root && root.dataset.url) {
    const base = root.dataset.url.replace(/\/$/, '');
    const anon = root.dataset.anon || '';
    const $ = <T extends HTMLElement>(id: string) => document.getElementById(id) as T;

    const gate = $('gate'), dash = $('dash'), lockBtn = $('lock');
    const gateForm = $<HTMLFormElement>('gate-form'), keyInput = $<HTMLInputElement>('key');
    const gateMsg = $('gate-msg'), edMsg = $('ed-msg');
    const editor = $<HTMLTextAreaElement>('ed');
    const saveBtn = $<HTMLButtonElement>('save'), resetBtn = $<HTMLButtonElement>('reset'), newBtn = $('new');
    const delBtn = $<HTMLButtonElement>('del'), formEl = $('form'), filterEl = $<HTMLInputElement>('filter');
    const tabForm = $('tab-form'), tabJson = $('tab-json');

    let key = '';
    let rows: Row[] = [];
    let current: string | null = null;
    type Chan = { channel_id: string; language: string; label: string | null; updated_at: string };
    let chans: Chan[] = [];
    const chBody = $('ch-body'), chMsg = $('ch-msg');
    const LANG_NAMES: Record<string, string> = { zh: 'Chinese', ja: 'Japanese', off: 'Off' };

    const store = {
      get: () => { try { return sessionStorage.getItem('yu-admin-key') || ''; } catch { return ''; } },
      set: (v: string) => { try { sessionStorage.setItem('yu-admin-key', v); } catch { /* ignore */ } },
      clear: () => { try { sessionStorage.removeItem('yu-admin-key'); } catch { /* ignore */ } },
    };

    async function rpc<T>(fn: string, args: Record<string, unknown>): Promise<T> {
      const res = await fetch(`${base}/rest/v1/rpc/${fn}`, {
        method: 'POST',
        headers: { apikey: anon, Authorization: `Bearer ${anon}`, 'Content-Type': 'application/json' },
        body: JSON.stringify(args),
      });
      if (!res.ok) {
        const body = await res.json().catch(() => ({}));
        const msg = String(body.message || '');
        if (/invalid admin key/i.test(msg)) throw new Error('That key is not valid.');
        throw new Error(msg || `Request failed (${res.status})`);
      }
      return res.json();
    }

    const say = (el: HTMLElement, text: string, kind: 'ok' | 'err' | '' = '') => {
      el.textContent = text;
      el.className = 'msg' + (kind ? ' ' + kind : '');
    };
    const fmt = (iso: string) => new Date(iso).toLocaleString();
    const countCommands = (d: Record<string, unknown>) =>
      d && typeof d.commands === 'object' && d.commands ? Object.keys(d.commands).length : 0;

    function renderStats() {
      const latest = rows.reduce((a, r) => (r.updated_at > a ? r.updated_at : a), '');
      const cells: [string, string][] = [
        [String(rows.length), 'Config files'],
        [String(rows.reduce((n, r) => n + countCommands(r.data), 0)), 'Commands defined'],
        [latest ? fmt(latest) : 'never', 'Last change'],
      ];
      $('stats').innerHTML = '';
      for (const [v, l] of cells) {
        const d = document.createElement('div');
        d.className = 'stat';
        const b = document.createElement('b'); b.textContent = v;
        const s = document.createElement('span'); s.textContent = l;
        d.append(b, s);
        $('stats').append(d);
      }
    }

    // ---------- editor state ----------
    type Obj = Record<string, any>;
    let model: Obj = {};
    let view: 'form' | 'json' = 'form';
    let dirty = false;
    let q = '';
    const openState = new Map<string, boolean>();
    const isObj = (v: unknown): v is Obj => typeof v === 'object' && v !== null && !Array.isArray(v);
    const kindOf = (v: unknown) => (Array.isArray(v) ? 'list' : v === null ? 'null' : typeof v === 'object' ? 'group' : typeof v);

    function renderMeta() {
      const r = rows.find((x) => x.name === current);
      $('ed-meta').textContent = current ? (r ? `Updated ${fmt(r.updated_at)}` : 'Not saved yet') + (dirty ? ' · unsaved changes' : '') : '';
    }
    function touch() { dirty = true; renderMeta(); }
    function setEnabled(on: boolean) {
      editor.disabled = saveBtn.disabled = resetBtn.disabled = delBtn.disabled = filterEl.disabled = !on;
    }
    function clearEditor() {
      current = null; model = {}; dirty = false;
      editor.value = ''; formEl.innerHTML = '';
      $('ed-name').textContent = 'Select a file';
      renderMeta(); setEnabled(false); renderFiles();
    }

    function renderFiles() {
      const nav = $('files');
      nav.innerHTML = '';
      const add = (name: string, note: string) => {
        const b = document.createElement('button');
        b.type = 'button';
        b.setAttribute('aria-current', String(name === current));
        const n = document.createElement('span'); n.textContent = name;
        const c = document.createElement('span'); c.textContent = note;
        b.append(n, c);
        b.addEventListener('click', () => guardedOpen(name));
        nav.append(b);
      };
      for (const r of rows) add(r.name, `${countCommands(r.data)} cmd`);
      if (current && !rows.some((r) => r.name === current)) add(current, 'new');
    }

    function guardedOpen(name: string) {
      if (name === current) return;
      if (dirty && !confirm('Discard your unsaved changes?')) return;
      open(name);
    }

    function open(name: string, text?: string) {
      current = name;
      const r = rows.find((x) => x.name === name);
      model = structuredClone(text !== undefined ? JSON.parse(text) : r?.data ?? {});
      openState.clear();
      q = ''; filterEl.value = '';
      dirty = text !== undefined;
      editor.value = JSON.stringify(model, null, 2);
      $('ed-name').textContent = name;
      setEnabled(true);
      say(edMsg, '');
      renderMeta(); renderForm(); renderFiles(); applyView();
    }

    // ---------- form editor ----------
    function h(tag: string, cls = '', text = ''): any {
      const e: any = document.createElement(tag);
      if (cls) e.className = cls;
      if (text) e.textContent = text;
      return e;
    }
    function mini(label: string, title: string, fn: () => void) {
      const b = h('button', 'mini', label);
      b.type = 'button'; b.title = title; b.setAttribute('aria-label', title);
      b.addEventListener('click', (ev: Event) => { ev.preventDefault(); ev.stopPropagation(); fn(); });
      return b;
    }
    const matches = (key: string | number, v: unknown) =>
      !q || String(key).toLowerCase().includes(q) || JSON.stringify(v).toLowerCase().includes(q);

    function renameKey(obj: Obj, from: string, to: string) {
      const entries = Object.entries(obj).map(([k, v]) => [k === from ? to : k, v] as [string, unknown]);
      for (const k of Object.keys(obj)) delete obj[k];
      for (const [k, v] of entries) obj[k] = v;
    }
    function removeAt(parent: any, key: string | number) {
      const v = parent[key];
      const big = typeof v === 'object' && v !== null && Object.keys(v).length > 0;
      if (big && !confirm(`Delete "${key}" and everything inside it?`)) return;
      if (Array.isArray(parent)) parent.splice(key as number, 1); else delete parent[key];
      touch(); renderForm();
    }
    function moveAt(arr: any[], i: number, dir: number) {
      const j = i + dir;
      if (j < 0 || j >= arr.length) return;
      [arr[i], arr[j]] = [arr[j], arr[i]];
      touch(); renderForm();
    }
    function actions(parent: any, key: string | number): HTMLElement {
      const g = h('div', 'mini-group');
      if (Array.isArray(parent)) {
        const i = key as number;
        g.append(mini('↑', 'Move up', () => moveAt(parent, i, -1)), mini('↓', 'Move down', () => moveAt(parent, i, 1)));
      } else {
        g.append(mini('Rename', 'Rename field', () => {
          const to = (prompt('New name', String(key)) || '').trim();
          if (!to || to === key) return;
          if (to === '__proto__' || to in parent) return say(edMsg, `"${to}" is not available.`, 'err');
          renameKey(parent, String(key), to); touch(); renderForm();
        }));
      }
      g.append(mini('✕', 'Delete', () => removeAt(parent, key)));
      return g;
    }

    function leaf(parent: any, key: string | number): HTMLElement {
      const v = parent[key];
      const label = `Value of ${key}`;
      if (typeof v === 'boolean') {
        const c = h('input'); c.type = 'checkbox'; c.checked = v; c.setAttribute('aria-label', label);
        c.addEventListener('change', () => { parent[key] = c.checked; touch(); });
        return c;
      }
      if (typeof v === 'number') {
        const i = h('input'); i.type = 'number'; i.step = 'any'; i.value = String(v); i.setAttribute('aria-label', label);
        i.addEventListener('input', () => { if (i.value !== '' && !isNaN(Number(i.value))) { parent[key] = Number(i.value); touch(); } });
        return i;
      }
      const s = v === null ? '' : String(v);
      const multi = s.length > 80 || s.includes('\n');
      const f = h(multi ? 'textarea' : 'input');
      f.value = s; f.setAttribute('aria-label', label);
      if (multi) f.rows = Math.min(10, Math.max(2, Math.ceil(s.length / 70) + s.split('\n').length - 1));
      if (multi) {
        const fit = () => { if (f.scrollHeight > 0) { f.style.height = 'auto'; f.style.height = f.scrollHeight + 2 + 'px'; } };
        f.addEventListener('input', fit);
        f.addEventListener('fit', fit);
        requestAnimationFrame(fit);
      }
      f.addEventListener('input', () => { parent[key] = f.value; touch(); });
      return f;
    }

    function fieldRow(parent: any, key: string | number, path: string, depth: number): HTMLElement | null {
      const v = parent[key];
      if (!matches(key, v)) return null;
      const isArr = Array.isArray(parent);
      const k = kindOf(v);
      if (k === 'group' || k === 'list') {
        const d = h('details', 'node');
        d.open = q ? true : openState.get(path) ?? depth === 0;
        d.addEventListener('toggle', () => { if (!q) openState.set(path, d.open); if (d.open) d.querySelectorAll('textarea').forEach((t: Element) => t.dispatchEvent(new Event('fit'))); });
        const n = k === 'list' ? v.length : Object.keys(v).length;
        const sum = h('summary');
        sum.append(
          h('span', 'node__name', isArr ? `#${(key as number) + 1}` : String(key)),
          h('span', 'node__count', `${n} ${k === 'list' ? 'item' : 'field'}${n === 1 ? '' : 's'}`),
          actions(parent, key),
        );
        const body = h('div', 'node__body');
        body.append(...children(v, path, depth + 1));
        d.append(sum, body);
        return d;
      }
      const row = h('div', isArr ? 'row row--item' : 'row');
      row.append(isArr ? h('span', 'idx', String((key as number) + 1)) : h('label', 'row__key', String(key)), leaf(parent, key), actions(parent, key));
      return row;
    }

    function children(node: any, path: string, depth: number): HTMLElement[] {
      const out: HTMLElement[] = [];
      for (const key of Array.isArray(node) ? node.map((_: unknown, i: number) => i) : Object.keys(node)) {
        const el = fieldRow(node, key, path + '\u0001' + key, depth);
        if (el) out.push(el);
      }
      if (!out.length && q) out.push(h('p', 'none', 'No matching fields.'));
      out.push(Array.isArray(node) ? addItem(node) : addField(node));
      return out;
    }

    function addItem(arr: any[]): HTMLElement {
      const first = arr[0];
      const label = isObj(first) ? '+ Add group' : typeof first === 'number' ? '+ Add number' : '+ Add line';
      const b = h('button', 'rowbtn', label);
      b.type = 'button';
      b.addEventListener('click', () => {
        arr.push(isObj(first) ? {} : typeof first === 'number' ? 0 : '');
        touch(); renderForm();
      });
      const w = h('div', 'addrow'); w.append(b);
      return w;
    }

    function addField(obj: Obj): HTMLElement {
      const w = h('div', 'addrow');
      const name = h('input'); name.placeholder = 'new field name'; name.setAttribute('aria-label', 'New field name'); name.maxLength = 60;
      const type = h('select'); type.setAttribute('aria-label', 'Field type');
      for (const [v, l] of [['text', 'Text'], ['list', 'List'], ['group', 'Group'], ['number', 'Number'], ['bool', 'Yes / No']]) {
        const o = h('option', '', l); o.value = v; type.append(o);
      }
      const go = h('button', 'rowbtn', 'Add field'); go.type = 'button';
      const run = () => {
        const n = name.value.trim();
        if (!n) return name.focus();
        if (n === '__proto__' || n in obj) return say(edMsg, `"${n}" already exists.`, 'err');
        obj[n] = { text: '', list: [], group: {}, number: 0, bool: false }[type.value as string];
        touch(); renderForm();
      };
      go.addEventListener('click', run);
      name.addEventListener('keydown', (e: KeyboardEvent) => { if (e.key === 'Enter') { e.preventDefault(); run(); } });
      w.append(name, type, go);
      return w;
    }

    function renderForm() {
      formEl.innerHTML = '';
      formEl.append(...children(model, '', 0));
    }

    // ---------- Form / JSON tabs ----------
    function applyView() {
      formEl.hidden = filterEl.hidden = view === 'json';
      editor.hidden = view === 'form';
      tabForm.setAttribute('aria-pressed', String(view === 'form'));
      tabJson.setAttribute('aria-pressed', String(view === 'json'));
    }
    function setView(next: 'form' | 'json') {
      if (next === view) return;
      if (next === 'json') {
        editor.value = JSON.stringify(model, null, 2);
      } else {
        try {
          const d = JSON.parse(editor.value);
          if (!isObj(d)) throw new Error('The top level must be a JSON object.');
          model = d;
        } catch (err) {
          return say(edMsg, 'Fix the JSON first: ' + (err as Error).message, 'err');
        }
        renderForm();
      }
      say(edMsg, '');
      view = next;
      applyView();
    }
    tabForm.addEventListener('click', () => setView('form'));
    tabJson.addEventListener('click', () => setView('json'));
    editor.addEventListener('input', touch);
    filterEl.addEventListener('input', () => { q = filterEl.value.trim().toLowerCase(); renderForm(); });
    window.addEventListener('beforeunload', (e) => { if (dirty) e.preventDefault(); });

    function renderChans() {
      chBody.innerHTML = '';
      if (!chans.length) {
        const tr = chBody.appendChild(document.createElement('tr'));
        const td = tr.appendChild(document.createElement('td'));
        td.colSpan = 4;
        td.className = 'empty';
        td.textContent = 'No channels saved yet.';
        return;
      }
      for (const c of chans) {
        const tr = document.createElement('tr');
        const idTd = document.createElement('td');
        const code = document.createElement('code'); code.textContent = c.channel_id;
        idTd.append(code);

        const langTd = document.createElement('td');
        const sel = document.createElement('select');
        sel.setAttribute('aria-label', 'Language for ' + c.channel_id);
        for (const [v, n] of Object.entries(LANG_NAMES)) {
          const o = document.createElement('option'); o.value = v; o.textContent = n;
          if (v === c.language) o.selected = true;
          sel.append(o);
        }
        if (!(c.language in LANG_NAMES)) {
          const o = document.createElement('option'); o.value = c.language; o.textContent = c.language; o.selected = true;
          sel.prepend(o);
        }
        langTd.append(sel);

        const noteTd = document.createElement('td');
        const note = document.createElement('input');
        note.value = c.label || ''; note.maxLength = 60;
        note.setAttribute('aria-label', 'Note for ' + c.channel_id);
        noteTd.append(note);

        const actTd = document.createElement('td');
        const save = document.createElement('button'); save.type = 'button'; save.className = 'rowbtn'; save.textContent = 'Save';
        const del = document.createElement('button'); del.type = 'button'; del.className = 'rowbtn'; del.textContent = 'Remove';
        save.addEventListener('click', () => chanAction(() => rpc('admin_set_translate_channel',
          { p_key: key, p_channel_id: c.channel_id, p_language: sel.value, p_label: note.value }), 'Saved.'));
        del.addEventListener('click', () => {
          if (confirm('Remove ' + c.channel_id + '? It falls back to TRANSLATE_CHANNEL_IDS or no translation.')) {
            chanAction(() => rpc('admin_delete_translate_channel', { p_key: key, p_channel_id: c.channel_id }), 'Removed.');
          }
        });
        actTd.append(save, del);
        tr.append(idTd, langTd, noteTd, actTd);
        chBody.append(tr);
      }
    }

    async function loadChans() {
      try {
        chans = await rpc<Chan[]>('admin_list_translate_channels', { p_key: key });
        renderChans();
      } catch (err) {
        say(chMsg, (err as Error).message + ' (Did you run the supabase migrations?)', 'err');
      }
    }

    async function chanAction(fn: () => Promise<unknown>, okText: string) {
      say(chMsg, 'Working…');
      try {
        await fn();
        await loadChans();
        say(chMsg, okText, 'ok');
      } catch (err) {
        say(chMsg, (err as Error).message, 'err');
      }
    }

    $<HTMLFormElement>('ch-form').addEventListener('submit', async (e) => {
      e.preventDefault();
      const id = $<HTMLInputElement>('ch-id'), note = $<HTMLInputElement>('ch-note');
      await chanAction(() => rpc('admin_set_translate_channel', {
        p_key: key, p_channel_id: id.value.trim(), p_language: $<HTMLSelectElement>('ch-lang').value, p_label: note.value,
      }), 'Saved.');
      if (chMsg.classList.contains('ok')) { id.value = ''; note.value = ''; }
    });

    // ---------- bot status ----------
    const stStatus = $<HTMLSelectElement>('st-status'), stType = $<HTMLSelectElement>('st-type');
    const stText = $<HTMLInputElement>('st-text'), stMsg = $('st-msg'), stPreview = $('st-preview');
    const STATUS_DEFAULT = { status: 'dnd', activity_type: 'playing', message: 'Apologies, Masters... Under Maintenance' };
    const optLabel = (sel: HTMLSelectElement) => sel.selectedOptions[0]?.textContent || '';

    function renderStatusPreview() {
      stText.disabled = stType.value === 'none';
      const act = stType.value === 'none' || !stText.value.trim()
        ? 'no activity'
        : stType.value === 'custom' ? stText.value.trim() : `${optLabel(stType)} ${stText.value.trim()}`;
      stPreview.textContent = `Preview: ${optLabel(stStatus)} · ${act}`;
    }
    for (const el of [stStatus, stType, stText]) el.addEventListener('input', renderStatusPreview);

    async function loadStatus() {
      try {
        const r = await rpc<{ status: string; activity_type: string; message: string | null }[]>('admin_get_status', { p_key: key });
        const s = r[0] ?? STATUS_DEFAULT;
        stStatus.value = s.status; stType.value = s.activity_type; stText.value = s.message || '';
        renderStatusPreview();
      } catch (err) {
        say(stMsg, (err as Error).message + ' (Did you run the supabase migrations?)', 'err');
      }
    }

    $<HTMLFormElement>('st-form').addEventListener('submit', async (e) => {
      e.preventDefault();
      say(stMsg, 'Saving…');
      try {
        await rpc('admin_set_status', {
          p_key: key, p_status: stStatus.value, p_activity_type: stType.value, p_message: stText.value,
        });
        say(stMsg, 'Saved. Yu updates within about 30 seconds.', 'ok');
      } catch (err) {
        say(stMsg, (err as Error).message, 'err');
      }
    });

    // ---------- force refresh ----------
    const refreshBtn = $<HTMLButtonElement>('refresh'), rfMsg = $('rf-msg');
    refreshBtn.addEventListener('click', async () => {
      refreshBtn.disabled = true;
      say(rfMsg, 'Requesting…');
      try {
        await rpc('admin_request_refresh', { p_key: key });
        say(rfMsg, 'Requested. Yu reloads config files and translation channels within about 30 seconds.', 'ok');
      } catch (err) {
        say(rfMsg, (err as Error).message + ' (Did you run the supabase migrations?)', 'err');
      }
      setTimeout(() => { refreshBtn.disabled = false; }, 10000);
    });

    async function load() {
      rows = await rpc<Row[]>('admin_list_configs', { p_key: key });
      await loadChans();
      await loadStatus();
      renderStats();
      renderFiles();
      if (current && rows.some((r) => r.name === current)) open(current);
      else if (rows[0]) open(rows[0].name);
      else {
        clearEditor();
        say(edMsg, 'No config files yet. Create one, or run scripts/seed_supabase.py in the bot repo.');
      }
    }

    async function unlock(k: string, remember = true) {
      key = k;
      await load();
      if (remember) store.set(k);
      gate.hidden = true;
      dash.hidden = false;
      lockBtn.hidden = false;
    }

    function lock() {
      key = '';
      store.clear();
      rows = [];
      clearEditor();
      keyInput.value = '';
      dash.hidden = true;
      gate.hidden = false;
      lockBtn.hidden = true;
      say(gateMsg, '');
    }

    gateForm.addEventListener('submit', async (e) => {
      e.preventDefault();
      say(gateMsg, 'Checking…');
      try {
        await unlock(keyInput.value.trim());
        keyInput.value = '';
        say(gateMsg, '');
      } catch (err) {
        say(gateMsg, (err as Error).message, 'err');
      }
    });

    lockBtn.addEventListener('click', lock);
    resetBtn.addEventListener('click', () => {
      if (!current) return;
      if (dirty && !confirm('Discard your unsaved changes?')) return;
      open(current, rows.some((r) => r.name === current) ? undefined : '{}');
    });

    newBtn.addEventListener('click', () => {
      if (dirty && !confirm('Discard your unsaved changes?')) return;
      const name = (prompt('File name (lowercase letters, digits, underscores). Example: general') || '').trim();
      if (!name) return;
      if (!/^[a-z0-9_]{1,40}$/.test(name)) return say(edMsg, 'Use lowercase letters, digits and underscores only.', 'err');
      if (rows.some((r) => r.name === name)) return open(name);
      open(name, '{}');
    });

    saveBtn.addEventListener('click', async () => {
      if (!current) return;
      let data: Obj;
      try {
        data = view === 'json' ? JSON.parse(editor.value) : model;
      } catch (err) {
        return say(edMsg, 'Invalid JSON: ' + (err as Error).message, 'err');
      }
      if (!isObj(data)) return say(edMsg, 'The top level must be a JSON object.', 'err');
      saveBtn.disabled = true;
      say(edMsg, 'Saving…');
      try {
        await rpc('admin_save_config', { p_key: key, p_name: current, p_data: data });
        await load();
        say(edMsg, 'Saved. Click Refresh bot to apply it now.', 'ok');
      } catch (err) {
        say(edMsg, (err as Error).message, 'err');
      } finally {
        saveBtn.disabled = !current;
      }
    });

    delBtn.addEventListener('click', async () => {
      if (!current) return;
      const name = current;
      if (!rows.some((r) => r.name === name)) {
        // never saved: just discard it
        dirty = false; clearEditor();
        if (rows[0]) open(rows[0].name);
        return;
      }
      if (!confirm(`Delete "${name}" from Supabase? After a restart the bot uses its bundled YAML for this file.`)) return;
      delBtn.disabled = true;
      say(edMsg, 'Deleting…');
      try {
        await rpc('admin_delete_config', { p_key: key, p_name: name });
        dirty = false; current = null;
        await load();
        say(edMsg, `Deleted "${name}".`, 'ok');
      } catch (err) {
        say(edMsg, (err as Error).message + ' (Did you run the latest supabase migration?)', 'err');
        delBtn.disabled = false;
      }
    });

    const saved = store.get();
    if (saved) unlock(saved, false).catch(() => lock());
  }
</script>
